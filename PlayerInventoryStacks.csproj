<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PlayerInventoryStacks</AssemblyName>
    <Version>1.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\The Planet Crafter\Planet Crafter_Data\Managed</GameManaged>
    <FrameworkPathOverride>$(GameManaged)</FrameworkPathOverride>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Reference Include="$(GameManaged)\netstandard.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameManaged)\*.dll" Exclude="$(GameManaged)\mscorlib.dll;$(GameManaged)\netstandard.dll;$(GameManaged)\System*.dll;$(GameManaged)\Mono*.dll"><Private>false</Private></Reference>
    <Reference Include="lib\BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="lib\0Harmony.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
